<script>
const $=s=>document.querySelector(s);
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const LS={get(k){try{return localStorage.getItem(k)}catch(e){return null}},set(k,v){try{localStorage.setItem(k,v)}catch(e){}}};
const EMPTY=()=>({deadline:null,reminder:null,subs:{}});
let demo=false,state=EMPTY(),pin='';

/* ---------- data layer (Vercel API, with local demo fallback) ---------- */
function localLoad(){try{return Object.assign(EMPTY(),JSON.parse(LS.get('s6state')))}catch(e){return EMPTY()}}
async function fetchState(){
  try{const r=await fetch('/api/state',{cache:'no-store'});if(!r.ok)throw 0;const j=await r.json();if(!j||!j.subs)throw 0;demo=false;state=j;}
  catch(e){demo=true;state=localLoad();}
  render();
}
function demoApply(b){
  const s=localLoad();
  if(b.action==='submit'){
    if(!/^https?:\/\/\S+$/i.test(b.url))throw new Error('Link must start with http:// or https://');
    s.subs[b.group]={mnc:b.mnc,url:b.url,ts:Date.now(),late:!!(s.deadline&&Date.now()>Date.parse(s.deadline))};
  }else{
    if(b.pin!=='1234')throw new Error('Wrong PIN (demo PIN is 1234)');
    if(b.action==='setDeadline')s.deadline=b.deadline?new Date(b.deadline).toISOString():null;
    if(b.action==='remind')s.reminder={id:Date.now(),msg:b.msg};
    if(b.action==='clearSub')delete s.subs[b.group];
    if(b.action==='reset'){s.subs={};s.reminder=null;s.deadline=null}
  }
  LS.set('s6state',JSON.stringify(s));return s;
}
async function send(body){
  if(demo){state=demoApply(body);render();return;}
  const r=await fetch('/api/state',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
  const j=await r.json().catch(()=>({}));
  if(!r.ok)throw new Error(j.error||'Something went wrong');
  state=j.state;render();
}

/* ---------- render ---------- */
function pending(){return [1,2,3,4,5,6].filter(g=>!state.subs[g])}
function render(){
  $('#demo').classList.toggle('hide',!demo);
  $('#live').classList.toggle('hide',demo);
  $('#pinlbl').textContent=demo?'Teacher PIN (demo PIN: 1234)':(state.pinSet?'Teacher PIN':'First time: create your teacher PIN (min 4 characters)');
  $('#board').innerHTML=[1,2,3,4,5,6].map(g=>{
    const s=state.subs[g];
    const st=s?(s.late?'<span class="status s-late">Late</span>':'<span class="status s-ok">Submitted ✓</span>'):'<span class="status s-wait">Waiting…</span>';
    const body=s?`<p style="margin:6px 0"><b>${esc(s.mnc)}</b></p><a class="btn sm" href="${esc(s.url)}" target="_blank" rel="noopener noreferrer">Open ↗</a>`:'<p style="margin:6px 0;color:var(--muted)">No link yet</p>';
    return `<div class="card" style="padding:16px"><h3>Group ${g}</h3>${st}${body}</div>`;
  }).join('');
  $('#clears').innerHTML=[1,2,3,4,5,6].filter(g=>state.subs[g]).map(g=>`<button class="btn sm" data-clr="${g}" type="button">Clear G${g}</button>`).join('')||'<span class="sub" style="margin:0">Nothing to clear.</span>';
  checkReminder();tick();
}
function tick(){
  const el=$('#cd');
  if(!state.deadline){el.textContent='⏰ No deadline yet';el.className='pill';return}
  const ms=Date.parse(state.deadline)-Date.now();
  if(ms<=0){el.textContent='⏰ Deadline passed';el.className='pill warn';return}
  const m=Math.floor(ms/60000),s=Math.floor(ms/1000)%60,h=Math.floor(m/60);
  el.textContent='⏰ '+(h?h+'h ':'')+String(m%60).padStart(2,'0')+':'+String(s).padStart(2,'0')+' left';
  el.className='pill'+(ms<600000?' warn':'');
}
setInterval(tick,1000);

/* ---------- reminder pop-up ---------- */
function checkReminder(){
  const r=state.reminder;if(!r)return;
  if(String(r.id)===LS.get('s6seen'))return;
  if(Date.now()-r.id>30*60000)return;
  LS.set('s6seen',String(r.id));
  const p=pending();
  $('#ovm').textContent=r.msg||'Please submit your link.';
  $('#ovp').textContent=p.length?'Still waiting for: '+p.map(g=>'Group '+g).join(', '):'All groups have submitted. 🎉';
  $('#ov').classList.remove('hide');
  try{if('Notification' in window&&Notification.permission==='granted')new Notification('Session 6 reminder',{body:r.msg})}catch(e){}
}
$('#ovx').onclick=()=>$('#ov').classList.add('hide');
$('#en').onclick=async()=>{
  if(!('Notification' in window)){alert('This browser does not support notifications. The pop-up will still appear while the page is open.');return}
  const p=await Notification.requestPermission();
  alert(p==='granted'?'Alerts on. Keep this tab open.':'Alerts blocked. The pop-up will still appear in the page.');
};

/* ---------- submit ---------- */
$('#sf').addEventListener('submit',async e=>{
  e.preventDefault();const m=$('#smsg');m.textContent='Sending…';
  try{
    await send({action:'submit',group:$('#sg').value,mnc:$('#sm').value.trim(),url:$('#su').value.trim()});
    m.textContent='✅ Group '+$('#sg').value+' submitted!';
  }catch(err){m.textContent='⚠️ '+err.message}
});

/* ---------- teacher ---------- */
$('#tt').onclick=()=>{const t=$('#teacher');t.classList.toggle('hide');if(!t.classList.contains('hide'))t.scrollIntoView()};
$('#unlock').onclick=async()=>{
  pin=$('#pin').value;
  try{await send({action:'check',pin});if(demo&&pin!=='1234')throw new Error('Wrong PIN (demo PIN is 1234)');$('#lock').classList.add('hide');$('#tools').classList.remove('hide');$('#lmsg').textContent=''}
  catch(e){$('#lmsg').textContent='⚠️ '+e.message}
};
async function admin(body,msgEl,ok){
  try{await send(Object.assign({pin},body));$(msgEl).textContent=ok}catch(e){$(msgEl).textContent='⚠️ '+e.message}
}
const pad=n=>String(n).padStart(2,'0');
const toLocal=d=>d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate())+'T'+pad(d.getHours())+':'+pad(d.getMinutes());
$('#setdl').onclick=()=>admin({action:'setDeadline',deadline:$('#dl').value||null},'#tmsg','✅ Deadline updated');
document.querySelectorAll('[data-add]').forEach(b=>b.onclick=()=>{
  const d=new Date(Date.now()+b.dataset.add*60000);$('#dl').value=toLocal(d);
  admin({action:'setDeadline',deadline:d.toISOString()},'#tmsg','✅ Deadline set');
});
$('#send').onclick=()=>admin({action:'remind',msg:$('#rm').value.trim()},'#tmsg','🔔 Reminder sent');
$('#clears').onclick=e=>{const g=e.target.dataset.clr;if(g)admin({action:'clearSub',group:g},'#tmsg','Cleared Group '+g)};
$('#reset').onclick=()=>{if(confirm('Reset all submissions, deadline and reminder?'))admin({action:'reset'},'#tmsg','Reset done')};

/* ---------- discussion timer ---------- */
let left=180,run=null;
const show=()=>$('#tm').textContent=pad(Math.floor(left/60))+':'+pad(left%60);
function beep(){try{const a=new(window.AudioContext||window.webkitAudioContext)(),o=a.createOscillator();o.connect(a.destination);o.frequency.value=880;o.start();setTimeout(()=>o.stop(),600)}catch(e){}}
document.querySelectorAll('[data-m]').forEach(b=>b.onclick=()=>{clearInterval(run);run=null;$('#tgo').textContent='▶ Start';left=b.dataset.m*60;show()});
$('#tgo').onclick=()=>{
  if(run){clearInterval(run);run=null;$('#tgo').textContent='▶ Start';return}
  if(left<=0)left=180;
  $('#tgo').textContent='⏸ Pause';
  run=setInterval(()=>{left--;show();if(left<=0){clearInterval(run);run=null;$('#tgo').textContent='▶ Start';beep()}},1000);
};
$('#trs').onclick=()=>{clearInterval(run);run=null;left=180;$('#tgo').textContent='▶ Start';show()};

fetchState();setInterval(fetchState,15000);
</script>
</body>
</html>
